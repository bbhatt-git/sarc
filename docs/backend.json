{
  "entities": {
    "admissionInquiry": {
      "title": "Admission Inquiry",
      "description": "Represents an inquiry for admission submitted through the website form.",
      "type": "object",
      "properties": {
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string" },
        "nationality": { "type": "string" },
        "citizenshipNo": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "alternatePhone": { "type": "string" },
        "permanentAddress": { "type": "string" },
        "district": { "type": "string" },
        "province": { "type": "string" },
        "applyingFor": { "type": "string" },
        "previousSchool": { "type": "string" },
        "lastClassCompleted": { "type": "string" },
        "gpa": { "type": "string" },
        "achievements": { "type": "string" },
        "fatherName": { "type": "string" },
        "fatherPhone": { "type": "string" },
        "fatherOccupation": { "type": "string" },
        "fatherEmail": { "type": "string", "format": "email" },
        "motherName": { "type": "string" },
        "motherPhone": { "type": "string" },
        "motherOccupation": { "type": "string" },
        "motherEmail": { "type": "string", "format": "email" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "guardianRelationship": { "type": "string" },
        "guardianEmail": { "type": "string", "format": "email" },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        }
      },
      "required": [
        "firstName", "lastName", "dob", "gender", "nationality", "email", "phone",
        "permanentAddress", "district", "province", "applyingFor", "previousSchool",
        "lastClassCompleted", "gpa", "fatherName", "fatherPhone", "fatherOccupation",
        "motherName", "motherPhone", "motherOccupation", "createdAt"
      ]
    },
    "message": {
      "title": "Contact Message",
      "description": "Represents a message submitted through the contact form.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "The full name of the person who sent the message."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The contact email address of the sender."
        },
        "phone": {
            "type": "string",
            "description": "The contact phone number of the sender."
        },
        "subject": {
          "type": "string",
          "description": "The subject of the message."
        },
        "message": {
          "type": "string",
          "description": "The content of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the message was submitted."
        }
      },
      "required": ["fullName", "email", "phone", "subject", "message", "createdAt"]
    },
     "result": {
      "title": "Exam Result",
      "description": "Represents a student's exam result.",
      "type": "object",
      "properties": {
        "SymbolNo": { "type": "string" },
        "StudentName": { "type": "string" },
        "DOB": { "type": "string", "description": "Date of Birth in YYYY-MM-DD format." },
        "GPA": { "type": "number" },
        "Grade": { "type": "string" },
        "Remarks": { "type": "string", "enum": ["Pass", "Fail"] }
      },
      "required": ["SymbolNo", "StudentName", "DOB", "GPA", "Grade", "Remarks"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/admissionInquiries/{inquiryId}": {
      "schema": {
        "$ref": "#/entities/admissionInquiry"
      },
      "description": "Collection of admission inquiries."
    },
    "/messages/{messageId}": {
      "schema": {
        "$ref": "#/entities/message"
      },
      "description": "Collection of contact form messages."
    },
    "/results/{resultId}": {
      "schema": {
        "$ref": "#/entities/result"
      },
      "description": "Collection of student exam results."
    }
  }
}
